## Copy to .env and change what you need. Everything is optional; see the
## tutorial: https://community-insights.readthedocs.io/en/latest/tutorial.html
## Remove the # in front of a setting to use it.

## The address of the site, comma separated.
# ALLOWED_HOSTS=community.example.org
## The address with https, when a proxy with TLS is in front.
# CSRF_TRUSTED_ORIGINS=https://community.example.org

## Sign in with GitHub: an OAuth app from https://github.com/settings/developers
## with the callback URL <your address>/accounts/github/login/callback/
# GITHUB_CLIENT_ID=
# GITHUB_SECRET=
## What sign in asks GitHub for.
# GITHUB_SCOPE=read:user

## The mail server for confirming addresses and resetting passwords.
## Without it, the mails are written to the log.
# EMAIL_HOST=smtp.example.org
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=community@example.org
## Port 465 uses SSL by default.
## EMAIL_USE_SSL can be set to true for other ports.
# EMAIL_USE_SSL=true
## none, optional or mandatory
# ACCOUNT_EMAIL_VERIFICATION=optional

## The superuser who administrates the site, as email:password. It signs in
## with the email address. Each start creates it, or sets this password again.
## Use a long password: with a default one such as admin, a production site
## does not start.
# DEFAULT_SUPERUSER=admin@example.com:a-long-password-only-you-know
## Test sites only, never on a site others can reach: allow default passwords.
# PRODUCTION=false

## Where the fetch worker runs: external-http-container (the default of the image,
## in the web container) or external-separate-container (the worker service of
## docker-compose.yml). internal is for development.
# FETCH_WORKER=external-separate-container
## Visitors without an account: repositories added and fetches started per
## address and hour; 0 for no limit.
# VISITOR_SUBMITS_PER_HOUR=10
# VISITOR_FETCHES_PER_HOUR=5
## Pull requests and issues the projects of an account may hold, except
## administrators; 0 for no limit.
# USER_MAX_ITEMS=100000
## Proxies in front of the site that add to X-Forwarded-For: 1 is the nginx of
## the image; 2 with one more proxy for TLS in front of it.
# TRUSTED_PROXIES=2
## The database; SQLite in ./data by default.
# DATABASE_URL=postgres://community:community@db/community
## The size the database is kept below, in megabytes; 0 for no limit.
# DATABASE_MAX_MB=1024
## Generated in ./data if empty. Changing them makes the stored tokens unreadable.
# SECRET_KEY=
# SALT_KEY=
