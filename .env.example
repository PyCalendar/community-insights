## Copy to .env and change what you need. Everything is optional; see the
## tutorial: https://community-insights.readthedocs.io/en/latest/tutorial.html
## and all settings: https://community-insights.readthedocs.io/en/latest/reference/configuration.html
## Remove the # in front of a setting to use it. The values shown are the
## defaults of the image, or examples where there is no default.


######## The address of the site ########

## The host names of the site, comma separated; * accepts every name.
# ALLOWED_HOSTS=community.example.org
## The address with https, comma separated, when a proxy with TLS is in front.
## Without it, forms such as the sign in fail behind the proxy.
# CSRF_TRUSTED_ORIGINS=https://community.example.org
## Proxies in front of the site that add to X-Forwarded-For: 1 is the nginx of
## the image; 2 with one more proxy for TLS in front of it. A number too high
## lets visitors choose their address, and with it their limits.
# TRUSTED_PROXIES=1
## The port of the container. Change the ports of docker-compose.yml with it.
# PORT=5000


######## The administrator ########

## The superuser who administrates the site, as email:password. It signs in
## with the email address. Each start creates it, or sets this password again.
## Use a long password: with a default one such as admin, a production site
## does not start.
# DEFAULT_SUPERUSER=admin@example.com:a-long-password-only-you-know
## Test sites only, never on a site others can reach: allow default passwords.
# PRODUCTION=true
## Development only, never on a site others can reach: debug pages with the
## settings, and the Django Debug Toolbar.
# DEBUG=false


######## Secrets ########

## Generated into ./data if empty; keep ./data. Changing one of them makes the
## stored GitHub tokens unreadable.
# SECRET_KEY=
# SALT_KEY=


######## GitHub ########

## Sign in with GitHub: an OAuth app from https://github.com/settings/developers
## with the callback URL <your address>/accounts/github/login/callback/
## Without it, people sign in with email and password and add tokens.
# GITHUB_CLIENT_ID=
# GITHUB_SECRET=
## What sign in asks GitHub for, comma separated. Private repositories need
## repo; people can also allow it later on the page GitHub access.
# GITHUB_SCOPE=read:user
## The API of GitHub; another address for GitHub Enterprise.
# GITHUB_API=https://api.github.com
## Private repositories are refused for now; true allows them.
# PRIVATE_REPOSITORIES=false


######## Mail ########

## The mail server for confirming addresses and resetting passwords.
## Without EMAIL_HOST, the mails are written to the log.
# EMAIL_HOST=smtp.example.org
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=community@example.org
## The encryption: without these, port 465 uses SSL (TLS from the start) and
## every other port TLS (STARTTLS, as port 587). Never set both to true.
## EMAIL_USE_TLS=false alone sends without encryption, to a mail server on the
## same machine.
# EMAIL_USE_SSL=true
# EMAIL_USE_TLS=true
## Whether people confirm their email address: none, optional or mandatory.
# ACCOUNT_EMAIL_VERIFICATION=optional


######## Data ########

## The directory of the SQLite database, the cache and the generated secrets.
## The image keeps it in /app/data, the volume of docker-compose.yml.
# DATA_DIR=/app/data
## The database; SQLite in DATA_DIR by default. PostgreSQL: see docker-compose.yml.
# DATABASE_URL=postgres://community:community@db/community
## The size the database is kept below, in megabytes; 0 for no limit. Above
## it, the data used longest ago is deleted; it is read again when needed.
# DATABASE_MAX_MB=1024
## Data fetched or looked at in these hours is never deleted to save space.
# DATABASE_MIN_AGE_HOURS=24
## Repositories and people nobody looked at for these days are deleted, once a
## day; 0 keeps everything.
# CACHE_KEEP_DAYS=90
## The cache shared by all processes: files in DATA_DIR/cache by default.
# CACHE_URL=redis://redis:6379/0
## false turns off the cache of the statistics, and with it the kept images.
# CACHALOT_ENABLED=true


######## Fetching from GitHub ########

## Where the fetch worker runs: external-http-container (the default of the
## image, a process in the web container) or external-separate-container (only
## the worker service of docker-compose.yml). internal is for development.
# FETCH_WORKER=external-http-container
## How many fetches run at the same time.
# FETCH_CONCURRENCY=4
## How many requests to GitHub run at the same time, for all tokens together.
# GITHUB_MAX_CONCURRENT=20


######## Limits ########

## Visitors without an account: repositories added and fetches started per
## address and hour; 0 for no limit.
# VISITOR_SUBMITS_PER_HOUR=10
# VISITOR_FETCHES_PER_HOUR=5
## Pull requests and issues the projects of an account may hold, except
## administrators; 0 for no limit.
# USER_MAX_ITEMS=100000


######## Memory ########

## gunicorn processes and threads. Each process needs about 300 MB for the
## libraries of the statistics; the fetch worker about 80 MB more. One process
## with 4 threads serves a small site.
# WORKERS=1
# THREADS=4


######## Links of the pages ########

## Where the code and the documentation of the running version are, for the
## links of the pages; change them for a fork.
# SOURCE_URL=https://github.com/PyCalendar/community-insights
# DOCS_URL=https://community-insights.readthedocs.io/en/latest/
